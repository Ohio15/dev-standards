#!/usr/bin/env bash
# commit-msg hook — conventional-commit subject + attribution scrub.
#
# Canonical source: https://github.com/Ohio15/dev-standards (hooks/commit-msg).
# install.sh copies this file to <repo>/.githooks/commit-msg. Do not edit the
# per-repo copy; change it here and re-run install.sh.
#
# Policy (dev-standards issue #5, decided 2026-09-11; rule 0 reversed the
# trailer allowance 2026-10-04):
#   0. Attribution is SCRUBBED, not rejected: every `Co-Authored-By:` trailer
#      (any author, any case, `Co-authored by:` too), every `Claude-Session:`
#      trailer and the `Generated with … Claude …` line are deleted from the
#      message file in place before any other rule runs — merge and revert
#      messages included. git commits whatever this hook leaves in the file.
#   1. Subject line is `<type>[(scope)][!]: <summary>`.
#      types: feat fix refactor chore docs test perf security build ci
#      (STANDARDS.md "Conventional commits"; scope and `!` per the
#      Conventional Commits spec so Dependabot `chore(deps):` and breaking
#      `feat!:` subjects are accepted).
#   2. Merge and revert commits are exempt from rules 1-5 (git writes their
#      subject).
#   3. Remaining PR-description boilerplate does not belong in a commit
#      message: lines containing `Generated with` or starting with `Auditor:`
#      are rejected.
#   4. Summary longer than 72 chars warns but does not block.
#   5. Past-tense summaries are rejected; write the imperative.
#
# Bypass (emergency only): git commit --no-verify — but note that also skips
# every other check in this file, including the scrub.

COMMIT_MSG_FILE="$1"
if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "commit-msg: no message file given" >&2
    exit 1
fi

# 0. Scrub attribution in place. '#' lines are git's template and are left
# alone; blank lines a removed trailer block leaves at the end are dropped.
# CRLF files keep their line endings (the \r is ignored only for matching):
# BINMODE=3 stops Git-for-Windows gawk from dropping CRs on read and write.
# LC_ALL=C matches bytes, so a leading emoji is not an invalid multibyte char
# under a UTF-8 locale.
SCRUB_TMP=$(mktemp "${COMMIT_MSG_FILE}.scrub.XXXXXX") || exit 1
trap 'rm -f "$SCRUB_TMP"' EXIT
SCRUBBED=$(LC_ALL=C awk -v BINMODE=3 '
    { line = $0; sub(/\r$/, "", line); l = tolower(line) }
    l !~ /^#/ && l ~ /^[ \t]*(co[- ]?authored[- ]by|claude-session)[ \t]*:/ { n++; next }
    l !~ /^#/ && l ~ /^[^a-z0-9]*generated with .*claude/ { n++; next }
    line ~ /^[ \t]*$/ { blank = blank $0 ORS; next }
    { printf "%s", blank; blank = ""; print }
    END { print n + 0 > "/dev/stderr" }
' "$COMMIT_MSG_FILE" 2>&1 >"$SCRUB_TMP") || exit 1
if [ "$SCRUBBED" -gt 0 ]; then
    cat "$SCRUB_TMP" > "$COMMIT_MSG_FILE" || exit 1
    echo "commit-msg: removed $SCRUBBED attribution line(s)"
fi

# First non-comment line is the subject (git strips '#' lines after this hook
# runs, so the file may still carry the commented template).
FIRST_LINE=$(grep -v '^#' "$COMMIT_MSG_FILE" | head -1)

# 2. Merge / revert commits: subject is written by git, not the author.
if echo "$FIRST_LINE" | grep -qE '^(Merge |Revert ")'; then
    exit 0
fi

# 1. Enforce <type>[(scope)][!]: <summary>
VALID_TYPES="feat|fix|refactor|chore|docs|test|perf|security|build|ci"
if ! echo "$FIRST_LINE" | grep -qE "^($VALID_TYPES)(\([^)]+\))?!?: .+"; then
    echo ""
    echo "COMMIT REJECTED: Subject does not follow <type>[(scope)]: <summary>."
    echo ""
    echo "  Your subject:  $FIRST_LINE"
    echo ""
    echo "  Valid types: feat, fix, refactor, chore, docs, test, perf, security, build, ci"
    echo "  Example:     feat: add player stats dashboard with filtering"
    echo "  Example:     chore(deps): bump fast-uri to 3.0.6"
    echo "  Example:     feat!: drop the v1 manifest format"
    echo ""
    exit 1
fi

# 3. PR boilerplate the scrub did not remove is rejected.
if grep -v '^#' "$COMMIT_MSG_FILE" | grep -qiE 'Generated with|^Auditor:'; then
    echo ""
    echo "COMMIT REJECTED: PR-description boilerplate in the commit message."
    echo ""
    echo "  Remove 'Generated with' / 'Auditor:' lines."
    echo ""
    exit 1
fi

# 4. Summary line length (warn only)
SUMMARY_LEN=${#FIRST_LINE}
if [ "$SUMMARY_LEN" -gt 72 ]; then
    echo ""
    echo "COMMIT WARNING: Subject is $SUMMARY_LEN chars (max 72)."
    echo "  Consider shortening: $FIRST_LINE"
    echo ""
fi

# 5. Imperative mood (catch the common past-tense openers)
SUMMARY=$(echo "$FIRST_LINE" | sed -E 's/^[a-z]+(\([^)]+\))?!?: //')
if echo "$SUMMARY" | grep -qE '^(Added|Fixed|Updated|Removed|Changed|Refactored|Implemented|Created) '; then
    echo ""
    echo "COMMIT REJECTED: Use imperative mood in the summary."
    echo ""
    echo "  Bad:  '$SUMMARY'"
    echo "  Good: '$(echo "$SUMMARY" | sed 's/^Added/add/;s/^Fixed/fix/;s/^Updated/update/;s/^Removed/remove/;s/^Changed/change/;s/^Refactored/refactor/;s/^Implemented/implement/;s/^Created/create/')'"
    echo ""
    exit 1
fi

exit 0
