# Parsed (never sourced) by .githooks/pre-commit-tests.sh. Keys: TEST_CMD,
# TEST_TIMEOUT, TEST_PATHS, TEST_CLEANUP_CMD (not needed here). Gates every
# commit that touches anything the suite reads on the full scripts/tests
# suite, the same command .github/workflows/tests.yml runs in CI (green on
# main; ~6 min locally, so the timeout leaves room). TEST_PATHS lists every
# tree the tests read (they load workflows, templates, hooks, install.sh and
# the security register from the checkout), plus requirements-dev.txt (the
# pinned test deps) and .gitattributes (it decides the line endings the
# tests see). The root README.md, STANDARDS.md and SECURITY-CHECKS.md are not
# read by any test, so a docs-only commit skips the suite. `python` first:
# on Windows `python3` is often the Store stub.
TEST_CMD=py="$(command -v python || command -v python3)"; "$py" -m pytest scripts/tests -q
TEST_TIMEOUT=900
TEST_PATHS=scripts/**|hooks/**|.githooks/**|.github/**|templates/**|workflows/**|release/**|security/**|install.sh|.pre-commit-tests|requirements-dev.txt|.gitattributes
